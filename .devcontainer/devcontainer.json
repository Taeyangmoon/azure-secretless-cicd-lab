{
  "name": "Azure Secretless Lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Sample app", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-github-actions",
        "ms-vscode.azurecli"
      ]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "postCreateCommand": "chmod +x scripts/*.sh && az version --output none"
}
